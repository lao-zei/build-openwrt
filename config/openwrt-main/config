cat > /etc/init.d/docker-bridge-fw4 << 'EOF'
#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
    /usr/bin/docker-bridge-fw4          # ← 开机先执行一次，补全网桥
    procd_open_instance
    procd_set_param command /usr/bin/docker-bridge-monitor
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall docker-bridge-monitor 2>/dev/null
}
EOF

chmod +x /etc/init.d/docker-bridge-fw4
